---
import { Image } from 'astro:assets';

interface Props {
  src: {
    src: string,
    width: number,
    height: number,
    format: string
  };
  alt: string;
  caption?: string;
}

const { src, alt, caption } = Astro.props as Props;
---

<div class="">
  <Image src={src} alt={alt} class="mx-auto max-w-lg rounded-lg"/>
  <p class="mt-2 text-center text-sm text-gray-600">{caption ? caption : alt}</p>
</div>
