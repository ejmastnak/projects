---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Project from '@/components/Project.astro'

import atticGymImg from '@/assets/img/tv47-attic-gym/9-complete.jpg'
import multimeterImg from '@/assets/img/lj16-panel/multimeter.jpg'
import screwdriverImg from '@/assets/img/lj16-panel/screwdriver-cropped.jpg'
import miniofficeImg from '@/assets/img/minioffice/monitor.jpg'

const title = "Home"
const description = "EliProjects is a site created for documenting my building projects to share with friends, family, and acquaintances. You'll find write-ups, photos, CAD plans, and the occasional story or anecdote of things I've built."
---

<BaseLayout title={title} description={description}>
  <div>

    <h1 class="text-5xl">Welcome</h1>

    <div class="mt-5 md:mt-8 max-w-2xl">
      <p>
        I created this site in fall 2025 to document building projects in a form I could share with family, friends, and acquaintances interested in seeing more.
        I used to be bad about taking pictures, and so never had anything to show! This site tries to solve that problem.

      </p>

      <p class="mt-2">Here you'll find write-ups, photos, CAD plans, and anecdotes of various hobby projects I've built in my spare time related to home improvment, woodworking, electrical, and adjacent "DIY" fields.</p>
    </div>

    <h2 class="mt-6 md:mt-8 text-3xl">Projects</h2>

    <p class="mt-4">Here is the list of projects — small for now, to be expanded soon:</p>

    <ul class="mt-10 flex flex-col gap-y-20">

      <!-- MiniOffice -->
      <Project
        name="MiniOffice"
        img={miniofficeImg}
        imgAlt="The view into the office from the hallway after painting"
        href="/minioffice/"
      >
        Building a small detached office in a decomissioned hallway bathroom in our family's Ljubljana apartment. 
      </Project>


      <!-- TV47 attic gym -->
      <li>
        <Project
          name="Attic gym"
          img={atticGymImg}
          imgAlt="The grid of perpendicular wooden sleepers built to provide an elastic base for the gym's floor."
          href="/attic-gym"
        >
          A gym built in the attic of my Dad's home in the Slovene countryside, designed with an elastic, "bouncy" floor to absorb the impact of weights and plyometric exercises while training.
        </Project>
      </li>

      <!-- LJ16 Panel -->
      <Project
        name="Electrical Panel Replacement"
        img={screwdriverImg}
        imgAlt="Original panel in the middle of disassembly: removing the original live busbar with an insulated screwdriver."
        href="/lj16-panel/"
      >
        Replacing the electrical panel in our family's Ljubljana apartment so as to install a residual current circuit breaker (RCCB), balance circuits, and clean up chaotic wiring.
      </Project>

    </ul>

  </div>
</BaseLayout>
